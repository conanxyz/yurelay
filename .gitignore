dist/
build/
.svelte-kit/
.vite/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]
/src-tauri/gen/

# Local artifacts, reference repositories and scratch work
/artifacts/
/Easydict/
/tmp/
/temp/
*.noindex/
/test-results/
/playwright-report/
/blob-report/

# macOS and editor state
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
